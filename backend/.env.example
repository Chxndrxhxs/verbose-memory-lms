# DATABASE_URL=mysql://root:Admin%402000@127.0.0.1:3306/masterlms
# or
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=masterlms
# DB_USER=root
# DB_PASSWORD=password
# DB_HOST=127.0.0.1
# DB_PORT=3306
