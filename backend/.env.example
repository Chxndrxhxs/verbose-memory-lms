SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins (learner 5173, instructor 5174, admin 5175)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Set True only for quick local dev behind no credentials edge cases
CORS_ALLOW_ALL_ORIGINS=False
# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
# MySQL (uncomment for MySQL) — encode @ in password as %40, e.g. Admin@2000 → Admin%402000
# DATABASE_URL=mysql://root:Admin%402000@127.0.0.1:3306/masterlms
# or
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=masterlms
# DB_USER=root
# DB_PASSWORD=password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Gemini (Google AI Studio) for PDF question extraction + generation
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your_ai_studio_key_here
# Retries per page before the extract endpoint pauses with 429 resume state
LLM_EXTRACT_MAX_RETRIES=6
